nt color=&quot;#545B64&quot;&gt;alertas operativas&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.topic;" vertex="1" parent="1"><mxGeometry x="895" y="806" width="48" height="48" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;user-notifications&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;avisos a usuarios&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.topic;" vertex="1" parent="1"><mxGeometry x="1090" y="806" width="48" height="48" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Destinos externos&lt;/b&gt;" style="fillColor=none;strokeColor=#7D8998;dashed=1;verticalAlign=top;fontStyle=0;fontColor=#232F3E;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="186" width="178" height="500" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Oracle OCI Object Storage&lt;/b&gt;&lt;br&gt;histórico .json.gz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C74634;strokeColor=none;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1404" y="246" width="150" height="70" as="geometry"/></mxCell><mxCell id="c43" value="sync_history.py · Always Free" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1404" y="322" width="150" height="24" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Usuarios afectados&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;y técnicos&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.email_2;" vertex="1" parent="1"><mxGeometry x="1455" y="596" width="48" height="48" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Operación y despliegue&lt;/b&gt;" style="fillColor=none;strokeColor=#7D8998;dashed=1;verticalAlign=top;fontStyle=0;fontColor=#232F3E;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="720" width="178" height="330" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;logs de las Lambdas&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1455" y="790" width="48" height="48" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;CloudFormation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Serverless Framework&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1455" y="930" width="48" height="48" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Línea continua: flujo directo&lt;br&gt;Línea punteada: validación o exportación por lotes&lt;br&gt;&lt;br&gt;&lt;b&gt;Costo en reposo casi nulo&lt;/b&gt;&lt;br&gt;Lambda, DynamoDB bajo demanda y SNS cobran solo por uso." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="720" width="200" height="170" as="geometry"/></mxCell><mxCell id="c49" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="94" y="470" as="sourcePoint"/><mxPoint x="168" y="278" as="targetPoint"/><Array as="points"><mxPoint x="122" y="470"/><mxPoint x="122" y="278"/></Array></mxGeometry></mxCell><mxCell id="c50" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="312" as="sourcePoint"/><mxPoint x="250" y="404" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="332" y="438" as="sourcePoint"/><mxPoint x="505" y="550" as="targetPoint"/><Array as="points"><mxPoint x="400" y="438"/><mxPoint x="400" y="550"/></Array></mxGeometry></mxCell><mxCell id="c52" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="531" y="522" as="sourcePoint"/><mxPoint x="531" y="352" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="559" y="550" as="sourcePoint"/><mxPoint x="648" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724" y="688" as="sourcePoint"/><mxPoint x="724" y="804" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="919" y="688" as="sourcePoint"/><mxPoint x="919" y="804" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1114" y="804" as="sourcePoint"/><mxPoint x="1114" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="620" as="sourcePoint"/><mxPoint x="1453" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1372" y="281" as="sourcePoint"/><mxPoint x="1402" y="281" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="111" y="361" width="22" height="22" as="geometry"/></mxCell><mxCell id="c60" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="389" y="477" width="22" height="22" as="geometry"/></mxCell><mxCell id="c61" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="541" y="430" width="22" height="22" as="geometry"/></mxCell><mxCell id="c62" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="592" y="523" width="22" height="22" as="geometry"/></mxCell><mxCell id="c63" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="733" y="735" width="22" height="22" as="geometry"/></mxCell><mxCell id="c64" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="735" width="22" height="22" as="geometry"/></mxCell><mxCell id="c65" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1123" y="735" width="22" height="22" as="geometry"/></mxCell><mxCell id="c66" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1328" y="590" width="22" height="22" as="geometry"/></mxCell><mxCell id="c67" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1376" y="252" width="22" height="22" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Cómo fluye una petición&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; El usuario entra por Cloudflare (DNS, WAF y TLS) y recibe el frontend estático desde Cloudflare Pages.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; El frontend llama por HTTPS a API Gateway con el token JWT en el encabezado Authorization.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; El Lambda Authorizer valida firma y expiración sin consultar la base, y entrega userId, rol y correo (RBAC: USUARIO, OPERADOR, ADMINISTRADOR).&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; API Gateway invoca la Lambda de cada microservicio. Todas usan el rol LabRole y guardan su estado en DynamoDB bajo demanda.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Cada reporte y cada métrica anómala publican eventos en SNS. Al crear una incidencia se evalúa la zona de inmediato: 10 o más usuarios distintos en menos de 24 horas crean un incidente colectivo.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; La correlación cruza los reportes con la antena de la zona (±60 minutos), calcula la prioridad P1 a P4 según usuarios afectados y criticidad, y publica la alerta colectiva. El flujo está definido como máquina de estados en Step Functions.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Los avisos a usuarios salen por el topic user-notifications hacia ms-notificaciones.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; ms-notificaciones despacha correo y SMS con SNS a los usuarios afectados y a los técnicos.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; sync_history.py exporta el histórico comprimido a OCI Object Storage (Always Free), por lotes. Serverless Framework despliega todo como un stack de CloudFormation y CloudWatch recibe los logs." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1112" width="1560" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>